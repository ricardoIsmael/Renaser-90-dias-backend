# Copia este archivo como `.env` y completa los valores. El `.env` esta ignorado por git.
#
# OJO: en la maquina de desarrollo las variables para correr en local estan cargadas en el IDE
# (run configuration de IntelliJ), NO aca. Este `.env` puede verse casi vacio y aun asi el backend
# arranca bien desde el IDE. Lo que NO hereda esas variables es arrancar desde la terminal
# (`./mvnw spring-boot:run`): ahi si hacen falta en el `.env` o exportadas en el shell.
# Ver `docs/DESPLIEGUE_Y_CI.md` seccion 6.1.
#
# Spring Boot no lee archivos .env por si solo: lo habilita la linea
# `spring.config.import: optional:file:.env[.properties]` de application.yaml.
# Formato de properties, no de shell: sin `export`, sin comillas alrededor del valor.

# Clave de la API de Gemini (Google AI Studio).
# IMPORTANTE: activa facturacion antes de usarla con datos reales. Los terminos del nivel
# gratuito piden explicitamente no enviar informacion sensible ni personal, y el Espejo de la
# Sombra manda diarios intimos. En el nivel pago, las instrucciones y respuestas no se usan
# para mejorar productos de Google.
GOOGLE_GENAI_API_KEY=

# Redis local (docker compose). Para probar autenticacion, define REDIS_PASSWORD;
# el compose arranca Redis con requirepass y Spring usa el mismo valor.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_SESSION_NAMESPACE=renaser:session:v2

# Proveedor de IA: `noop` (default) mantiene los adaptadores vacios y la app arranca sin
# credenciales. `google` los reemplaza por los reales — NO lo pongas todavia: esos adaptadores
# aun no existen y el arranque va a fallar por puertos sin implementacion.
IA_PROVEEDOR=noop

# Web Push (VAPID). La clave pública también se configura en EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY
# del frontend. La privada nunca se expone al navegador.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:soporte@renaser.com

	<build>
		<pluginManagement>
			<plugins>
				<!--
					Solo fija la version para que `./mvnw sonar:sonar` no resuelva "la ultima que
					haya" y cambie de comportamiento entre maquinas. No se ata a ninguna fase: el
					analisis lo dispara el workflow de GitHub Actions, no un build local.
				-->
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${sonar-maven-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
				JaCoCo. `prepare-agent` no instrumenta nada por si mismo: escribe la opcion
				-javaagent en la propiedad `argLine`, que es la MISMA que leen surefire y failsafe
				(los dos declaran ese parametro con property="argLine"). Por eso las pruebas
				unitarias y las de integracion suman al mismo `target/jacoco.exec` (el agente
				abre en modo append) y un unico `report` cubre las dos.

				OJO: si algun dia hace falta configurar <argLine> a mano en surefire, hay que
				incluir @{argLine} dentro — un <argLine> literal pisa el del agente y la
				cobertura queda en 0% sin ningun error visible.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<!-- En `verify`, no en `test`: asi el XML incluye tambien lo que
						     cubrieron las *IT. Consecuencia a tener presente: `./mvnw clean test`
						     NO genera el reporte de cobertura; hace falta `verify`. -->
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!--
				Pruebas UNITARIAS. Los includes son los mismos que surefire trae por defecto: se
				escriben explicitos para que quede a la vista cual es el reparto, no para
				cambiarlo. El repo usa `*Test.java` para unitarias (331 archivos) y `*IT.java`
				para las que necesitan Postgres/Redis reales (10 archivos); no se renombro nada.
				El <exclude> tampoco cambia nada hoy — `*IT.java` ya quedaba fuera de los
				includes — pero deja la intencion escrita en vez de depender de un default.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/Test*.java</include>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
						<include>**/*TestCase.java</include>
					</includes>
					<excludes>
						<exclude>**/*IT.java</exclude>
					</excludes>
				</configuration>
			</plugin>
			<!--
				Pruebas de INTEGRACION. Antes de este cambio los 10 archivos `*IT.java` no los
				corria nadie en el build: surefire nunca los incluyo (no encajan en sus patrones
				por defecto) y failsafe no estaba declarado. Se ejecutaban solo a mano desde el
				IDE. Con esto entran a `./mvnw clean verify` y al CI.

				Necesitan Docker: los 10 son @SpringBootTest + @Import(TestcontainersConfiguration)
				contra Postgres (pgvector/pgvector:pg16) y Redis (redis:7-alpine) reales.

				Los goals (`integration-test` + `verify`) y `classesDirectory` ya vienen del
				pluginManagement de spring-boot-starter-parent — ese classesDirectory es el que
				evita que failsafe corra contra el jar ya reempaquetado por Boot en `package`.
				Aca solo se acota que archivos son "de integracion".
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<!-- El ORDEN importa: Lombok -> binding -> MapStruct. -->
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok-mapstruct-binding</artifactId>
									<version>${lombok-mapstruct-binding.version}</version>
								</path>
								<path>
									<groupId>org.mapstruct</groupId>
									<artifactId>mapstruct-processor</artifactId>
									<version>${mapstruct.version}</version>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<!-- Mismo set que default-compile: sin mapstruct-processor aca,
							     cualquier @Mapper declarado en src/test no se genera. -->
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok-mapstruct-binding</artifactId>
									<version>${lombok-mapstruct-binding.version}</version>
								</path>
								<path>
									<groupId>org.mapstruct</groupId>
									<artifactId>mapstruct-processor</artifactId>
									<version>${mapstruct.version}</version>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>

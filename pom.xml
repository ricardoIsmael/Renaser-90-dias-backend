			<!--
				BOM del SDK de AWS: alinea a una sola version las ~20 dependencias transitivas
				de `s3` (auth, regions, http-client-spi, netty...). Sin el habria que fijar la
				version de cada artefacto a mano.
			-->
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${aws-sdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!--
				BOM de Spring Cloud AWS: fija la version de los artefactos `io.awspring.cloud:*`
				del starter de Parameter Store.

				VA DESPUES del BOM del SDK a proposito. Este BOM tambien importa
				`software.amazon.awssdk:bom` (en la 4.1.1, la 2.54.3), y en Maven la PRIMERA
				declaracion de una version gana. Con este orden, el numero del SDK lo sigue
				mandando `${aws-sdk.version}` de arriba — una sola version de SDK en todo el
				build, visible en una propiedad nuestra, en vez de una heredada en silencio.
				Invertir el orden no rompe hoy (los dos numeros coinciden), pero desacopla la
				propiedad del artefacto que realmente se resuelve.
			-->
			<dependency>
				<groupId>io.awspring.cloud</groupId>
				<artifactId>spring-cloud-aws-dependencies</artifactId>
				<version>${spring-cloud-aws.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
